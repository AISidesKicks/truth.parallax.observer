Python Extraction ScriptSave this in your scripts/ folder as extract_youtube.py. This script grabs the transcript and formats it cleanly for your markdown files.Pythonfrom youtube_transcript_api import YouTubeTranscriptApi
import sys

def get_video_transcript(video_id):
    try:
        # Fetch the transcript (defaults to English)
        transcript = YouTubeTranscriptApi.get_transcript(video_id)
        
        # Stitch the dictionary list into a single readable text block
        full_text = " ".join([segment['text'] for segment in transcript])
        
        # Clean up common YouTube transcript artifacts
        full_text = full_text.replace('\n', ' ').replace('  ', ' ')
        
        return full_text
    
    except Exception as e:
        return f"Error extracting {video_id}: {str(e)}"

# Example Usage:
if __name__ == "__main__":
    vid_id = "hLPPE3_DVCw" # Neil deGrasse Tyson video
    print(f"--- Extracted Transcript for {vid_id} ---\n")
    print(get_video_transcript(vid_id))
