# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO

# --- Development ---------------------------------------------------------
DEBUG=false

# --- llama.cpp: one router server for both models ------------------------
# The model presets live in config/llama-models.ini
LLM_PORT=11433
LLM_MODEL_ALIAS=granite-4.0-h-tiny
LLM_API_BASE=http://localhost:11433/v1

# Set this to the standalone embedding server if you run the embed profile
EMBEDDING_API_BASE=http://localhost:11433/v1
EMBED_MODEL_ALIAS=embeddinggemma-2

# --- llama.cpp: standalone embedding server (optional) -------------------
EMBED_PORT=7997
EMBED_MODEL_FILE=embeddinggemma-2-Q8_0.gguf
EMBED_CTX_SIZE=2048
EMBED_N_GPU_LAYERS=99
EMBED_BATCH=512
EMBED_POOLING=mean

# --- OpenViking ----------------------------------------------------------
VIKING_PORT=1933
OPENVIKING_ROOT_API_KEY=parallax-local
OPENVIKING_API_KEY=put-the-user-key-here
OPENVIKING_ACCOUNT=default
OPENVIKING_USER=default
# VIKING_WORKSPACE belongs to the container, the compose sets it there.
# The host path is the one below.
VIKING_EMBEDDING_BASE=http://prlx-llm:8080/v1
VIKING_VLM_BASE=http://prlx-llm:8080/v1
VIKING_EMBEDDING_MODEL=embeddinggemma-2
VIKING_VLM_MODEL=granite-4.0-h-tiny
VIKING_EMBEDDING_API_KEY=parallax-local
VIKING_VLM_API_KEY=parallax-local

# --- Application ---------------------------------------------------------
EMBEDDING_MODEL=embeddinggemma-2
EMBEDDING_DIMENSION=768
OPENVIKING_URL=http://prlx-viking:1933
# the host path of the memory workspace, the container uses /app/viking_data
OPENVIKING_WORKSPACE=memory/openviking

# --- Observability -------------------------------------------------------
PHOENIX_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://prlx-phoenix:4317
