# parallax.observer - OpenViking context server
#
# CPU only. The heavy lifting (embeddings, LLM summaries) is delegated to the
# llama.cpp services over the prlx-lab network.
#
# The sdist needs Rust to build the `ov` CLI, so we pin the manylinux wheel
# that ships the same version.

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY docker/requirements-viking.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    openviking-server --version

RUN mkdir -p /app/viking_data /app/facts

COPY config/openviking.conf /app/openviking.conf
COPY docker/openviking-entrypoint.sh /usr/local/bin/openviking-entrypoint.sh
RUN chmod +x /usr/local/bin/openviking-entrypoint.sh

EXPOSE 1933

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=20 \
    CMD curl -fsS http://localhost:1933/health || exit 1

ENTRYPOINT ["openviking-entrypoint.sh"]
